# Defaults to localhost mode. Never expose the unsecured default to the public Internet.
DEPLOYMENT_MODE=local
# Public mode: use >=32 high-entropy random characters.
MCP_BEARER_TOKEN=
# Required in public mode: comma-separated literal hostnames only, without ports.
ASTRO_ALLOWED_HOSTS=
# Exact allowed browser origins for MCP in public mode (not the Host list).
MCP_ALLOWED_ORIGINS=

# Optional external OAuth resource-server mode (ALL values required together).
# Requires a separate trusted OAuth/OIDC authorization server and public HTTPS proxy.
ASTRO_PUBLIC_BASE_URL=
ASTRO_OAUTH_ISSUER=
ASTRO_OAUTH_JWKS_URL=
ASTRO_OAUTH_AUDIENCE=

# Optional AI chat (pip install '.[chat]' or '.[chat-openai]'). Leave empty to disable.
# Claude: setting ANTHROPIC_API_KEY alone enables it with model claude-opus-5-5.
ANTHROPIC_API_KEY=
# openai = any OpenAI-compatible endpoint; needs XUANSHU_LLM_MODEL.
XUANSHU_LLM_PROVIDER=
XUANSHU_LLM_MODEL=
XUANSHU_LLM_BASE_URL=
XUANSHU_LLM_API_KEY=
# Claude effort: low | medium | high | xhigh | max (default medium)
XUANSHU_LLM_EFFORT=
